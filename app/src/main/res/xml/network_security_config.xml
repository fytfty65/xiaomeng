<?xml version="1.0" encoding="utf-8"?>
<!--
  开发期本地网关走明文 HTTP；Android 9+ 默认禁止明文流量，
  未声明时所有 http://10.0.2.2:8080 请求都会以 IOException 失败，
  界面只能显示「网络连接失败」。
  这里只对回环/模拟器宿主机，以及当前正式网关 IP 放开明文，
  其他域名仍强制 HTTPS。网关换成域名后请改为 HTTPS 并删掉该 IP。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">118.178.237.166</domain>
    </domain-config>
</network-security-config>
